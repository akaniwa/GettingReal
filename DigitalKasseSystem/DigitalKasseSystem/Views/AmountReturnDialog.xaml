<Window x:Class="DigitalKasseSystem.Views.AmountReturnDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DigitalKasseSystem.Views"
        mc:Ignorable="d"
        Title="AmountReturnDialog" Height="250" Width="250">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel>
            <Label Content="Byttepenge:" FontSize="40" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="10"/>
            <Separator/>
            <Label Name="ReturnAmountLabel" Content="0.00 kr." FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </StackPanel>
        <UniformGrid Grid.Row="1">
            <Button Content="OK" FontSize="20" Click="OKButton_Click" Margin="10"/>
        </UniformGrid>
    </Grid>
</Window>
