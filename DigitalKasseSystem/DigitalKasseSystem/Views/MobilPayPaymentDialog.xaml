<Window x:Class="DigitalKasseSystem.Views.MobilPayPaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DigitalKasseSystem.Views"
        mc:Ignorable="d"
        Title="MobilPayPaymentDialog" Height="500" Width="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" >
            <Image x:Name="mobilpayImage" Height="200" Width="200" Source="/Image/mobilpayQRl.jpg"/>
            <Label x:Name="TotalLabel" Content="Total: 0.00 kr." FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </StackPanel>
        <UniformGrid VerticalAlignment="Center" HorizontalAlignment="Center">
            <Label Content="MobilPay" FontSize="30" FontWeight="Bold"/>
        </UniformGrid>
        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Button Content="OK" Height="70" Width="200" FontSize="20" Click="OkButton_Click"/>
            <Button Content="Annuller" Height="50" Width="200" FontSize="20" Click="AnnullerButton_Click"/>
        </StackPanel>

    </Grid>
</Window>
