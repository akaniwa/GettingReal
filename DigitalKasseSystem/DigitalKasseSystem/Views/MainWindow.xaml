<Window x:Class="DigitalKasseSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DigitalKasseSystem"
        mc:Ignorable="d"
        Title="Uldum Hal - Kiosk" 
        Height="{x:Static SystemParameters.PrimaryScreenHeight}" 
        Width="{x:Static SystemParameters.PrimaryScreenWidth}"
        WindowState="Maximized">


    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <UniformGrid Grid.Row="0" Grid.ColumnSpan="3">
            <Label Content="SimplePOS" FontSize="108" FontWeight="Bold" VerticalContentAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20" FontFamily="Arial Black"/>
        </UniformGrid>

        <UniformGrid Rows="2" Columns="2" Grid.Row="1" Grid.Column="1">
            <Button x:Name="SaleButton" Width="auto" Height="auto" Content="Salg" FontSize="36" Click="SaleButton_Click" Margin="10"/>
            <Button x:Name="AssortmentButton" Width="auto" Height="auto" Content="Sortiment" FontSize="36" Click="AssortmentButton_Click" Margin="10"/>
            <Button x:Name="ReportsButton" Width="auto" Height="auto" Content="Rapporter (Ikke implementeret)" FontSize="36" Click="NotImplementedButton_Click" Margin="10"/>
            <Button x:Name="SettingsButton" Width="auto" Height="auto" Content="Indstillinger (Ikke implementeret)" FontSize="36" Click="NotImplementedButton_Click" Margin="10"/>
        </UniformGrid>
    </Grid>
</Window>
