<Window x:Class="DigitalKasseSystem.Views.ChangeOrdreDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DigitalKasseSystem.Views"
        mc:Ignorable="d"
        Title="ChangeOrdreDialog" Height="500" Width="300">
    <Grid Margin="0,0,0,4">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0">
            <Label Grid.Row="0" Content="Indtast ordre nummer" HorizontalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="60" Width="300" FontSize="28"/>
            <TextBox Grid.Row="0" x:Name="InputTextBox" HorizontalAlignment="Center" TextWrapping="WrapWithOverflow" Text="" FontSize="45"  Width="200" Height="60" HorizontalContentAlignment="Center"/>
        </StackPanel>

        <UniformGrid Rows="4" Columns="3" Grid.Row="1">
            <Button Content="1" Tag="1" Height="60" Width="60" Click="NumberButton_Click" FontSize="30" Grid.Row="1"/>
            <Button Content="2" Tag="2" Height="60" Width="60" FontSize="30" Click="NumberButton_Click" Grid.Row="1"/>
            <Button Content="3" Tag="3" Height="60" Width="60" FontSize="30" Click="NumberButton_Click" Grid.Row="1"/>
            <Button Content="4" Tag="4" Height="60" Width="60" FontSize="30" Click="NumberButton_Click" Grid.Row="1"/>
            <Button Content="5" Tag="5" Height="60" Width="60" FontSize="30" Click="NumberButton_Click" Grid.Row="1"/>
            <Button Content="6" Tag="6" Height="60" Width="60" FontSize="30" Click="NumberButton_Click" Grid.Row="1"/>
            <Button Content="7" Tag="7" Height="60" Width="60" FontSize="30" Click="NumberButton_Click" Grid.Row="1"/>
            <Button Content="8" Tag="8" Height="60" Width="60" FontSize="30" Click="NumberButton_Click" Grid.Row="1"/>
            <Button Content="9" Tag="9" Height="60" Width="60" FontSize="30" Click="NumberButton_Click" Grid.Row="1"/>

            <Button Content="✓" Height="60" Width="60" FontSize="30" Click="DoneButton_Click" Grid.Row="1"/>
            <Button Content="0" Tag="0" Height="60" Width="60" FontSize="30" Click="NumberButton_Click" Grid.Row="1"/>
            <Button Content="⌫" Tag="delete" Height="60" Width="60" FontSize="30" Click="DeleteButton_Click" Grid.Row="1"/>
        </UniformGrid>
    </Grid>
</Window>
